# Optional Wiki.js settings for the Flask process and export script.
# This project does not auto-load dotenv files. Export these variables in the
# shell or add the real .env as an EnvironmentFile in the Flask systemd unit.

WIKIJS_URL=http://127.0.0.1:3000
# Fill this only after creating a backend extraction key in Wiki.js.
WIKIJS_API_TOKEN=
WIKIJS_LOCALE=en
WIKIJS_TIMEOUT_SECONDS=10
