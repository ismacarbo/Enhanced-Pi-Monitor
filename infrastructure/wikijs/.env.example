# Copy this file to .env. The real .env is ignored by Git.
# Generate a password with: openssl rand -base64 48

WIKIJS_IMAGE=ghcr.io/requarks/wiki:2.5.314
WIKIJS_BIND_ADDRESS=127.0.0.1
WIKIJS_PORT=3000
WIKIJS_DB_NAME=wikijs
WIKIJS_DB_USER=wikijs
# Required. Compose refuses to start while this is empty.
WIKIJS_DB_PASSWORD=
